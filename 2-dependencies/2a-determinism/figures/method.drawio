<diagram name="method" id="method"><mxGraphModel adaptiveColors="auto" background="#FFFFFF" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1040" pageHeight="1220"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Experiment 2a · Build determinism in NuGet&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;shape=text;strokeColor=none;fillColor=none;align=left;spacing=0;fontSize=28;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="960" height="38" as="geometry"/></mxCell><mxCell id="subtitle" value="Revised protocol | Compare two local builds of the same source commit" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;shape=text;strokeColor=none;fillColor=none;align=left;spacing=0;fontSize=18;fontColor=#52626D;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="960" height="26" as="geometry"/></mxCell><mxCell id="fixed" value="&lt;b&gt;Fixed laboratory&lt;/b&gt; &amp;nbsp; Arch Linux · .NET SDK 10.0.403 · shared dependency cache" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;fillColor=#F0F4F6;strokeColor=none;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40" y="118" width="960" height="52" as="geometry"/></mxCell><mxCell id="select" value="&lt;b&gt;1 &amp;nbsp; Identify source and project&lt;/b&gt;&lt;br&gt;341 shipped package versions → 224 build candidates&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Repository URL + source commit + matching project&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;fillColor=#F0F4F6;strokeColor=#6E8594;" vertex="1" parent="1"><mxGeometry x="40" y="204" width="640" height="94" as="geometry"/></mxCell><mxCell id="unavailable" value="&lt;b&gt;117 stop here&lt;/b&gt;&lt;br&gt;No managed assembly or&lt;br&gt;missing source / project&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Record the reason&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;fillColor=#F6F6F4;strokeColor=#A2A29A;fontSize=17;" vertex="1" parent="1"><mxGeometry x="740" y="204" width="260" height="94" as="geometry"/></mxCell><mxCell id="e-stop" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#536975;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#394D59;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="select" target="unavailable"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prepare" value="&lt;b&gt;2 &amp;nbsp; Prepare and attempt a build&lt;/b&gt;&lt;br&gt;Check out commit · use fixed SDK · restore dependencies&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Build and pack the selected project&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;fillColor=#F0F4F6;strokeColor=#6E8594;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="640" height="94" as="geometry"/></mxCell><mxCell id="screenfail" value="&lt;b&gt;Build fails&lt;/b&gt;&lt;br&gt;Record the first error&lt;br&gt;Stop testing this package" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;fillColor=#F6F6F4;strokeColor=#A2A29A;fontSize=17;" vertex="1" parent="1"><mxGeometry x="740" y="340" width="260" height="94" as="geometry"/></mxCell><mxCell id="e-select" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#536975;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#394D59;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="select" target="prepare"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-screenfail" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#536975;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#394D59;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="prepare" target="screenfail"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pairs" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;fillColor=#F8FAFB;strokeColor=#6E8594;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="40" y="482" width="640" height="268" as="geometry"/></mxCell><mxCell id="pairtitle" value="&lt;b&gt;3 &amp;nbsp; Build a control–variation pair&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;shape=text;strokeColor=none;fillColor=none;align=left;spacing=0;fontSize=20;" vertex="1" parent="1"><mxGeometry x="62" y="500" width="596" height="28" as="geometry"/></mxCell><mxCell id="matrix" value="2 build modes × 8 variations = 16 comparisons per package" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;shape=text;strokeColor=none;fillColor=none;align=left;spacing=0;fontSize=17;" vertex="1" parent="1"><mxGeometry x="62" y="537" width="596" height="24" as="geometry"/></mxCell><mxCell id="control" value="&lt;b&gt;Control build&lt;/b&gt;&lt;br&gt;Reference environment" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;fontSize=18;" vertex="1" parent="1"><mxGeometry x="64" y="586" width="270" height="76" as="geometry"/></mxCell><mxCell id="varied" value="&lt;b&gt;Varied build&lt;/b&gt;&lt;br&gt;One dimension changed" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;fontSize=18;" vertex="1" parent="1"><mxGeometry x="386" y="586" width="270" height="76" as="geometry"/></mxCell><mxCell id="modes" value="&lt;b&gt;Baseline:&lt;/b&gt; project build defaults&lt;br&gt;&lt;b&gt;Configured:&lt;/b&gt; same commands + deterministic-build properties" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;shape=text;strokeColor=none;fillColor=none;align=left;spacing=0;fontSize=17;" vertex="1" parent="1"><mxGeometry x="64" y="684" width="594" height="48" as="geometry"/></mxCell><mxCell id="e-ready" value="Build succeeds" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#536975;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#394D59;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="prepare" target="pairs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="axes" value="&lt;b&gt;Eight variations&lt;/b&gt;&lt;br&gt;&lt;br&gt;Build path&lt;br&gt;Environment variables&lt;br&gt;Locale&lt;br&gt;Executable search path&lt;br&gt;System time (+1 year)&lt;br&gt;Time zone&lt;br&gt;File-creation mask&lt;br&gt;Filesystem ordering" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;fillColor=#FFFFFF;strokeColor=#B3BEC5;align=left;fontSize=17;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="740" y="482" width="260" height="268" as="geometry"/></mxCell><mxCell id="compare" value="&lt;b&gt;4 &amp;nbsp; Compare outputs and classify&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;SHA-256 comparison at each boundary&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;fillColor=#F0F4F6;strokeColor=#6E8594;" vertex="1" parent="1"><mxGeometry x="40" y="804" width="640" height="64" as="geometry"/></mxCell><mxCell id="boundary1" value="&lt;b&gt;Whole package&lt;/b&gt;&lt;br&gt;.nupkg bytes" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="200" height="68" as="geometry"/></mxCell><mxCell id="boundary2" value="&lt;b&gt;Package content&lt;/b&gt;&lt;br&gt;Exclude packaging metadata" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;fontSize=16;" vertex="1" parent="1"><mxGeometry x="260" y="890" width="200" height="68" as="geometry"/></mxCell><mxCell id="boundary3" value="&lt;b&gt;Assemblies&lt;/b&gt;&lt;br&gt;lib/ · ref/ · runtimes/" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;fontSize=17;" vertex="1" parent="1"><mxGeometry x="480" y="890" width="200" height="68" as="geometry"/></mxCell><mxCell id="verdict" value="&lt;b&gt;Per comparison:&lt;/b&gt; same / differs / failed" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;fillColor=#F0F4F6;strokeColor=none;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="978" width="640" height="46" as="geometry"/></mxCell><mxCell id="classes" value="&lt;b&gt;Per package, at each boundary&lt;/b&gt;&lt;br&gt;As is &amp;nbsp; / &amp;nbsp; With configuration &amp;nbsp; / &amp;nbsp; Unreproducible" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;fillColor=#E6EDF1;strokeColor=#6E8594;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="1048" width="640" height="64" as="geometry"/></mxCell><mxCell id="e-category" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#536975;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#394D59;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="verdict" target="classes"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="readout" value="&lt;b&gt;Comparison outcomes&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Differs:&lt;/b&gt; outputs exist&lt;br&gt;but bytes differ.&lt;br&gt;&lt;br&gt;&lt;b&gt;Failed:&lt;/b&gt; at least one&lt;br&gt;build produces no package.&lt;br&gt;&lt;br&gt;Failure is recorded separately&lt;br&gt;from a measured difference." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;fillColor=#F6F6F4;strokeColor=#A2A29A;align=left;spacingLeft=18;fontSize=17;" vertex="1" parent="1"><mxGeometry x="740" y="804" width="260" height="308" as="geometry"/></mxCell><mxCell id="foot" value="Protocol shown: 224 candidates and a full test matrix. The 1–2 November run used 90 measured packages&lt;br&gt;and partial configured coverage; see Methods for the classification assumptions." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;shape=text;strokeColor=none;fillColor=none;align=left;spacing=0;fontSize=16;fontColor=#52626D;" vertex="1" parent="1"><mxGeometry x="40" y="1140" width="960" height="48" as="geometry"/></mxCell><mxCell id="e-pair-compare" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#536975;strokeWidth=1.5;" edge="1" parent="1" source="pairs" target="compare"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
