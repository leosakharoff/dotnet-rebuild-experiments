<diagram name="method" id="method"><mxGraphModel adaptiveColors="auto" background="#FFFFFF" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1040" pageHeight="1040"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Experiment 2b · Rebuild against nuget.org&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;shape=text;strokeColor=none;fillColor=none;align=left;spacing=0;fontSize=28;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="960" height="38" as="geometry"/></mxCell><mxCell id="subtitle" value="One command from what the release names | compare with the DLL nuget.org serves" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;shape=text;strokeColor=none;fillColor=none;align=left;spacing=0;fontSize=18;fontColor=#52626D;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="960" height="26" as="geometry"/></mxCell><mxCell id="inputs" value="&lt;b&gt;Inputs&lt;/b&gt; &amp;nbsp; nuget.org: .nupkg, .nuspec, DLL, PDB · the source at the declared commit · nothing from CI" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;fillColor=#F0F4F6;strokeColor=none;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40" y="118" width="960" height="52" as="geometry"/></mxCell><mxCell id="derive" value="&lt;b&gt;1 &amp;nbsp; Derive a recipe&lt;/b&gt; &amp;nbsp; derive.py&lt;br&gt;341 shipped → 198 name commit and compiler → 157 recipes&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;SDK from csc.dll · OS from CRLF · build folder · line endings · project · version&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;fillColor=#F0F4F6;strokeColor=#6E8594;" vertex="1" parent="1"><mxGeometry x="40" y="204" width="640" height="100" as="geometry"/></mxCell><mxCell id="norecipe" value="&lt;b&gt;41 no recipe&lt;/b&gt;&lt;br&gt;Compiler in no public SDK&lt;br&gt;or on .NET Framework, ...&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Record the rule&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;fillColor=#F6F6F4;strokeColor=#A2A29A;fontSize=17;" vertex="1" parent="1"><mxGeometry x="740" y="204" width="260" height="100" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#536975;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#394D59;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="derive" target="norecipe"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="build" value="&lt;b&gt;2 &amp;nbsp; Build twice&lt;/b&gt; &amp;nbsp; rebuild.py&lt;br&gt;dotnet build PROJECT -c Release &amp;lt;props&amp;gt;&lt;br&gt;&amp;amp;&amp;amp; dotnet pack --no-build&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;SDK alone · fresh clone · empty cache · A, then A2 in the same paths&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;fillColor=#F0F4F6;strokeColor=#6E8594;" vertex="1" parent="1"><mxGeometry x="40" y="346" width="640" height="120" as="geometry"/></mxCell><mxCell id="nopackage" value="&lt;b&gt;71 no package&lt;/b&gt;&lt;br&gt;Build fails, or packs&lt;br&gt;another id or version&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Record the first error&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;fillColor=#F6F6F4;strokeColor=#A2A29A;fontSize=17;" vertex="1" parent="1"><mxGeometry x="740" y="346" width="260" height="120" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#536975;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#394D59;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="derive" target="build"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#536975;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#394D59;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="build" target="nopackage"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="hosts" value="&lt;b&gt;Where&lt;/b&gt;&lt;br&gt;Windows recipes:&lt;br&gt;windows-2022&lt;br&gt;Linux recipes: arch,&lt;br&gt;or ubuntu-24.04 for a&lt;br&gt;runner's build folder" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;fillColor=#FFFFFF;strokeColor=#B3BEC5;align=left;fontSize=17;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="740" y="504" width="260" height="150" as="geometry"/></mxCell><mxCell id="compare" value="&lt;b&gt;3 &amp;nbsp; Compare the DLL Phoenix ships&lt;/b&gt; &amp;nbsp; level.py&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;dllreport.cs on both; stripsign.cs for the signatures&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=cent