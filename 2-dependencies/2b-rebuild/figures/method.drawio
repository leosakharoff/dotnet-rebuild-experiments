" height="66" as="geometry"/></mxCell><mxCell id="classes" value="&lt;b&gt;Per package&lt;/b&gt;&lt;br&gt;Reproduced (22) &amp;nbsp; / &amp;nbsp; Built, but differs (64) &amp;nbsp; / &amp;nbsp; Not built (112)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;fillColor=#E6EDF1;strokeColor=#6E8594;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="640" height="64" as="geometry"/></mxCell><mxCell id="control" value="&lt;b&gt;Control:&lt;/b&gt; A against A2 · 76 equal, 9 differ (the clock)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;fillColor=#F0F4F6;strokeColor=none;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="640" height="44" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=8;strokeColor=#536975;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#394D59;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="compare" target="classes"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="536"/><mxPoint x="20" y="722"/></Array></mxGeometry></mxCell><mxCell id="extra" value="&lt;b&gt;After the result: the publisher's own build&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Arcade repositories, 96 packages · the repository's script at the commit + OfficialBuildId&lt;br&gt;windows-2022: 35 of 42 identical without signatures · Linux (VMR): 0 of 54&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;fillColor=#FFFFFF;strokeColor=#8A99A4;dashed=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="960" height="90" as="geometry"/></mxCell><mxCell id="foot" value="Part 2a's level 1 does not apply: nuget.org adds .signature.p7s to every package. Its levels 2 and 3: 9 and 11 of 86.&lt;br&gt;Grades are of the one DLL Phoenix ships, part 2a's level 3 narrowed to it." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1C2933;strokeColor=#8A99A4;strokeWidth=1.2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=12;shape=text;strokeColor=none;fillColor=none;align=left;spacing=0;fontSize=16;fontColor=#52626D;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="960" height="48" as="geometry"/></mxCell></root></mxGraphModel></diagram>
