<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram name="Comparison within each stage" id="rq1">
    <mxGraphModel page="1" pageWidth="600" pageHeight="420" grid="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="setup" value="&lt;b&gt;Before each build&lt;/b&gt;&lt;br&gt;Export the same commit outside Git. Use the pinned SDK and hash its compiler.&lt;br&gt;Start with an empty environment, no bin/ or obj/, and build servers stopped." style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;fontSize=16;fontColor=#000000;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="8" y="8" width="584" height="68" />
        </mxCell>
        <mxCell id="pair" value="&lt;b&gt;Build twice&lt;/b&gt;&lt;br&gt;Run a baseline build, then rebuild&lt;br&gt;with one condition varied." style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;fontSize=16;fontColor=#000000;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="8" y="104" width="266" height="76" />
        </mxCell>
        <mxCell id="compare" value="&lt;b&gt;Compare the outputs&lt;/b&gt;&lt;br&gt;Check each file’s SHA-256 hash." style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;fontSize=16;fontColor=#000000;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="8" y="221" width="266" height="61" />
        </mxCell>
        <mxCell id="trace" value="&lt;b&gt;Trace the difference&lt;/b&gt;&lt;br&gt;Identify the file and field." style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;fontSize=16;fontColor=#000000;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="335" y="221" width="257" height="61" />
        </mxCell>
        <mxCell id="fix" value="&lt;b&gt;Apply a fix and retest&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;fontSize=16;fontColor=#000000;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="335" y="104" width="257" height="76" />
        </mxCell>
        <mxCell id="advance" value="&lt;b&gt;Continue testing&lt;/b&gt;&lt;br&gt;Try the next condition, then all&lt;br&gt;conditions together. Repeat the&lt;br&gt;procedure at the next stage." style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;fontSize=16;fontColor=#000000;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="8" y="335" width="266" height="82" />
        </mxCell>
        <mxCell id="record" value="&lt;b&gt;Record external action&lt;/b&gt;&lt;br&gt;Describe what the verifier or&lt;br&gt;tool maintainer must do." style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;fontSize=16;fontColor=#000000;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="335" y="335" width="257" height="82" />
        </mxCell>
        <mxCell id="edge-setup-pair" edge="1" source="setup" target="pair" parent="1" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#111111;strokeWidth=1.4;exitX=0.2277;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge-pair-compare" edge="1" source="pair" target="compare" parent="1" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#111111;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge-compare-trace" edge="1" source="compare" target="trace" parent="1" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#111111;strokeWidth=1.4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge-trace-fix" edge="1" source="trace" target="fix" parent="1" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#111111;strokeWidth=1.4;exitX=0.5;exitY=0;entryX=0.5;entryY=1;">
