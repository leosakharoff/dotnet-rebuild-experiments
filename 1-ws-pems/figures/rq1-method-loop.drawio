<diagram name="rq1-method-loop" id="rq1-method-loop"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="570" pageHeight="300" background="#FFFFFF"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="v1" value="&lt;b&gt;Every build:&lt;/b&gt; one commit, exported outside git · the pinned SDK, its compiler hashed ·&lt;br&gt;no &lt;i&gt;bin/&lt;/i&gt; or &lt;i&gt;obj/&lt;/i&gt; · .NET&#x27;s build servers stopped · an empty environment" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontSize=12;fontFamily=Helvetica;fontColor=#000000;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="570" height="46" as="geometry"/></mxCell>
<mxCell id="v2" value="&lt;b&gt;1&lt;/b&gt; Build twice" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontSize=12;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0" y="76" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="v3" value="&lt;b&gt;2&lt;/b&gt; Vary one condition&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;build path, time, locale, umask,&lt;br&gt;time zone, environment, ...&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontSize=12;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="200" y="76" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="v4" value="&lt;b&gt;3&lt;/b&gt; Compare the SHA-256&lt;br&gt;of every output file" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontSize=12;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="400" y="76" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="v5" value="all&lt;br&gt;equal?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontSize=12;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="450" y="150" width="70" height="56" as="geometry"/></mxCell>
<mxCell id="v6" value="Next condition, then all at&lt;br&gt;once, then the next stage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F1DF;strokeColor=#5B8F4E;strokeWidth=1;fontSize=12;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="400" y="236" width="170" height="50" as="geometry"/></mxCell>
